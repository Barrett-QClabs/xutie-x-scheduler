# 至少 16 位的随机字符串。用来加密保存在数据库里的 X 凭据。
# 换掉这个值之后，之前保存的凭据无法再解密，需要重新填写。
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-string

# SQLite 文件。目录不存在时会自动创建。
DATABASE_PATH=./data/xqueue.sqlite

# 只有精确的 live 会请求 X。未设置、mock 或其他值都留在本地模拟。
# 准备正式发帖时才改成 live，并先确认队列仍处于暂停。
X_API_MODE=mock

# 监听地址。默认只绑定本机回环。不要改成 0.0.0.0，除非这是容器里、
# 由已有认证的反向代理转发，并且端口没有直接暴露到公网。
HOST=127.0.0.1

# npm run dev / npm start 读取这个端口，默认 3847。
PORT=3847

# 关注/取关旧进程默认不启动。不要为了账号1取关把它改成 on，那会连带尝试回关和关键词关注。
XUTIE_AUTOMATION_SUPERVISOR=off

# 账号1自动取关批次。默认关闭。只有设为 on，并且账号1已验证为指定用户后，
# POST /api/unfollow/batches 才会执行。它不改变发帖队列的暂停状态。
XUTIE_ACCOUNT1_UNFOLLOW=off
